{
	"name": "@widgetarium/studio",
	"version": "0.1.0",
	"description": "The studio drawn around a Widgetarium app",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"scripts": {
		"dev": "npm --prefix ../.. run dev",
		"build": "npm --prefix ../.. run build",
		"start": "npm --prefix ../.. run install-vault"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./studio.css": {
			"style": "./dist/studio.css",
			"default": "./dist/studio.css"
		}
	},
	"dependencies": {
		"@widgetarium/app-host": "0.1.0",
		"@widgetarium/assistant": "0.1.0",
		"@widgetarium/behaviors": "0.1.0",
		"@widgetarium/browser": "0.1.0",
		"@widgetarium/canvas": "0.1.0",
		"@widgetarium/command-menu": "0.1.0",
		"@widgetarium/core": "0.1.0",
		"@widgetarium/gpu": "0.1.0",
		"@widgetarium/kit": "0.1.0",
		"@widgetarium/mascot": "0.1.0",
		"@widgetarium/pack-catalogue": "0.1.0",
		"@widgetarium/layout": "0.1.0",
		"@widgetarium/workspaces": "0.1.0",
		"radix-ui": "^1.7.0"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.6.5"
	},
	"widgetarium": {
		"level": "app"
	}
}
