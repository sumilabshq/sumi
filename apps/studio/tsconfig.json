{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"lib": ["ES2022", "DOM"],
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"tsBuildInfoFile": "../../node_modules/.cache/widgetarium/studio.tsbuildinfo",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"references": [
		{
			"path": "../../packages/shared/kit"
		},
		{
			"path": "../../packages/shared/core"
		},
		{ "path": "../../packages/shared/data-framework" }
	],
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"../../packages/shared/core/src/*.d.ts",
		"../../packages/shared/kit/src/jsx-namespace.d.ts"
	]
}
