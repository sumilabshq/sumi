{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"tsBuildInfoFile": "../../../../node_modules/.cache/widgetarium/file-system.tsbuildinfo",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"references": [{ "path": "../../../../packages/shared/data-framework" }],
	"include": [
		"*.ts",
		"gateways/**/*.ts",
		"features/**/*.ts",
		"shared/**/*.ts",
		"generated/**/*.ts",
		"../../../../packages/shared/core/src/*.d.ts"
	]
}
