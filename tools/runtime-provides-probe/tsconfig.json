{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"types": []
	},
	"include": ["*.ts"]
}
