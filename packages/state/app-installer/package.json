{
	"name": "@widgetarium/app-installer",
	"version": "0.1.0",
	"description": "Sumi's app installer: the registry, the apps installed with their versions, install, update and roll back",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./module": {
			"source": "./module.ts",
			"types": "./dist/module.d.ts",
			"default": "./dist/module.js"
		}
	},
	"dependencies": {
		"@sumi/contract": "0.3.1",
		"@tauri-apps/api": "^2.12.4",
		"@widgetarium/core": "0.1.0"
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
