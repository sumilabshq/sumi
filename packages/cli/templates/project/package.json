{
	"name": "{name}",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"generate": "widgetarium generate",
		"dev": "widgetarium generate && vite",
		"studio": "widgetarium generate && vite --mode studio",
		"build": "widgetarium generate && npm run typecheck && vite build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run lint && npm run format:check && npm run typecheck && widgetarium check"
	},
	"dependencies": {
		"motion": "^14.1.0",
		"radix-ui": "^1.7.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-is": "^19.3.0",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "10.11.0",
		"prettier": "3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"prettier": {
		"useTabs": true,
		"tabWidth": 2,
		"printWidth": 120,
		"semi": true,
		"singleQuote": false,
		"quoteProps": "as-needed",
		"jsxSingleQuote": false,
		"trailingComma": "all",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"arrowParens": "always",
		"endOfLine": "lf"
	}
}
