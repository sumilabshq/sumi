{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Widgetarium",
	"version": "0.1.0",
	"identifier": "app.widgetarium.studio",
	"build": {
		"devUrl": "http://localhost:5173",
		"frontendDist": "../dist",
		"beforeBuildCommand": "npm run build:frontend"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "Widgetarium",
				"width": 1440,
				"height": 900,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 6,
					"y": 18
				}
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"icon": ["icons/icon.png"]
	}
}
