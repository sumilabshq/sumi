{
	"name": "@widgetarium/canvas",
	"version": "0.1.0",
	"description": "The design canvas as data: an app's pages, states, references and widgets, and what the canvas shows of them",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		"./contract": {
			"source": "./generated/contract.ts",
			"types": "./dist/generated/contract.d.ts",
			"default": "./dist/generated/contract.js"
		},
		"./implementation": {
			"source": "./generated/module.ts",
			"types": "./dist/generated/module.d.ts",
			"default": "./dist/generated/module.js"
		}
	},
	"imports": {
		"#module": {
			"source": "./generated/command.ts",
			"types": "./dist/generated/command.d.ts",
			"default": "./dist/generated/command.js"
		}
	},
	"dependencies": {
		"@widgetarium/behaviors": "0.1.0",
		"@widgetarium/core": "0.1.0",
		"@widgetarium/data-framework": "0.1.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"obsidian": "^1.13.1"
	},
	"peerDependencies": {
		"obsidian": "^1.13.1",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"obsidian": {
			"optional": true
		}
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
