{
	"name": "@widgetarium/canvas",
	"version": "0.1.0",
	"description": "The design canvas: an app's pages, states, references and widgets laid out to look at and change",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./module": {
			"source": "./module.ts",
			"types": "./dist/module.d.ts",
			"default": "./dist/module.js"
		},
		"./vault": {
			"source": "./vault.ts",
			"types": "./dist/vault.d.ts",
			"default": "./dist/vault.js"
		}
	},
	"dependencies": {
		"@widgetarium/behaviors": "0.1.0",
		"@widgetarium/core": "0.1.0",
		"@widgetarium/gpu": "0.1.0",
		"@widgetarium/kit": "0.1.0",
		"modern-screenshot": "^4.7.0",
		"radix-ui": "^1.7.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"obsidian": "^1.13.1"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.6.5",
		"obsidian": "^1.13.1"
	},
	"peerDependenciesMeta": {
		"obsidian": {
			"optional": true
		}
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
