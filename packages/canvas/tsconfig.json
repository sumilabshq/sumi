{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react",
		"jsxFactory": "h",
		"jsxFragmentFactory": "Fragment",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"tsBuildInfoFile": "../../node_modules/.cache/widgetarium/canvas.tsbuildinfo",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": []
	},
	"references": [{ "path": "../kit" }, { "path": "../core" }],
	"include": [
		"*.ts",
		"schema/**/*.ts",
		"ports/**/*.ts",
		"requests/**/*.ts",
		"ui/**/*.ts",
		"ui/**/*.tsx",
		"../core/src/*.d.ts",
		"../kit/src/jsx-namespace.d.ts"
	]
}
