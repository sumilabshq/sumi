{
	"name": "@widgetarium/core",
	"version": "0.1.0",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./app": {
			"source": "./src/app.ts",
			"types": "./dist/app.d.ts",
			"default": "./dist/app.js"
		},
		"./styles.css": {
			"style": "./dist/styles.css",
			"default": "./dist/styles.css"
		},
		"./*": {
			"source": "./src/*",
			"types": "./dist/*",
			"default": "./dist/*"
		}
	},
	"dependencies": {
		"@babel/parser": "^8.0.5",
		"@radix-ui/react-dismissable-layer": "1.1.20",
		"@radix-ui/react-focus-guards": "1.1.6",
		"@radix-ui/react-focus-scope": "1.2.0",
		"@radix-ui/react-portal": "1.1.18",
		"@widgetarium/data-framework": "0.1.0",
		"@widgetarium/kit": "0.1.0",
		"aria-hidden": "1.2.6",
		"motion": "^14.1.0",
		"radix-ui": "^1.7.0",
		"react-remove-scroll": "2.7.2",
		"sucrase": "^3.35.0",
		"tailwind-merge": "^3.7.0",
		"yaml": "^2.9.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"widgetarium": {
		"level": "common"
	}
}
