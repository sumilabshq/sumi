{
	"name": "@widgetarium/app-registry",
	"version": "0.1.0",
	"description": "Sumi's built-in apps: every apps/* folder holding a sumi-app.json, its build and the modules it brings, generated by widgetarium generate",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"source": "./index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./modules": {
			"source": "./modules.ts",
			"types": "./dist/modules.d.ts",
			"default": "./dist/modules.js"
		}
	},
	"dependencies": {
		"@widgetarium/core": "0.1.0",
		"@widgetarium/tasks": "0.1.0",
		"@widgetarium/terminal": "0.1.0"
	},
	"widgetarium": {
		"level": "common"
	},
	"sideEffects": false
}
