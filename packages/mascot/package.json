{
	"name": "@widgetarium/mascot",
	"version": "0.1.0",
	"description": "Ink, the agent's mascot: drawn wherever the agent is, answering what the agent does",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist",
		"mascot.css"
	],
	"exports": {
		".": {
			"source": "./generated/index.ts",
			"types": "./dist/generated/index.d.ts",
			"default": "./dist/generated/index.js"
		},
		"./module": {
			"source": "./generated/module.ts",
			"types": "./dist/generated/module.d.ts",
			"default": "./dist/generated/module.js"
		},
		"./gateways": {
			"source": "./generated/gateways.ts",
			"types": "./dist/generated/gateways.d.ts",
			"default": "./dist/generated/gateways.js"
		},
		"./mascot.css": "./mascot.css"
	},
	"dependencies": {
		"@widgetarium/core": "0.1.0"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.6.5"
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
