{
	"name": "@sumi/tab-groups",
	"version": "0.1.0",
	"description": "Tab groups in the tab store: making, naming, colouring, folding, moving and dissolving a window's groups, through the store's one writer",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		"./contract": {
			"source": "./generated/contract.ts",
			"types": "./dist/generated/contract.d.ts",
			"default": "./dist/generated/contract.js"
		},
		"./implementation": {
			"source": "./generated/module.ts",
			"types": "./dist/generated/module.d.ts",
			"default": "./dist/generated/module.js"
		}
	},
	"imports": {
		"#module": {
			"source": "./generated/command.ts",
			"types": "./dist/generated/command.d.ts",
			"default": "./dist/generated/command.js"
		}
	},
	"dependencies": {
		"@widgetarium/data-framework": "0.1.0",
		"@widgetarium/navigation": "0.1.0"
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
