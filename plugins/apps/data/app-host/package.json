{
	"name": "@widgetarium/app-host",
	"version": "0.1.0",
	"description": "The app host as data: the studio's tabs, groups and essentials, the column they stand in and which app is shown, kept between starts",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		"./contract": {
			"source": "./generated/contract.ts",
			"types": "./dist/generated/contract.d.ts",
			"default": "./dist/generated/contract.js"
		},
		"./implementation": {
			"source": "./generated/module.ts",
			"types": "./dist/generated/module.d.ts",
			"default": "./dist/generated/module.js"
		}
	},
	"imports": {
		"#module": {
			"source": "./generated/command.ts",
			"types": "./dist/generated/command.d.ts",
			"default": "./dist/generated/command.js"
		}
	},
	"dependencies": {
		"@sumi/apps": "0.1.0",
		"@widgetarium/app-registry": "0.1.0",
		"@widgetarium/behaviors": "0.1.0",
		"@widgetarium/browser": "0.1.0",
		"@widgetarium/core": "0.1.0",
		"@widgetarium/data-framework": "0.1.0",
		"@widgetarium/layout": "0.1.0",
		"@widgetarium/places": "0.1.0",
		"@widgetarium/workspaces": "0.1.0"
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"widgetarium": {
		"level": "domain"
	},
	"sideEffects": false
}
